# Política de ejecución SDD (Starlark).
#
# Prohíbe los comandos que saltan el ciclo de calidad del repositorio. Es la segunda capa: la
# primera es hooks/sdd-commit-guard-codex.js. Ninguna de las dos cubre todas las rutas por sí sola
# (un script intermedio puede ejecutar git sin pasar por el matcher del hook), por eso van las dos.
#
# Codex carga este fichero al arrancar: un parámetro que `prefix_rule` no reconoce impide el
# arranque entero, no solo esta regla. El motivo va en `justification` (con `reason`, codex-cli
# 0.162.1 sale con «Error loading rules»). Comprobación: `codex execpolicy check`.

prefix_rule(
    pattern = ["git", "commit", "--no-verify"],
    decision = "forbidden",
    justification = "SDD: --no-verify salta los ganchos de calidad. Corrige la causa del fallo, no lo esquives.",
)

prefix_rule(
    pattern = ["git", "push", "--no-verify"],
    decision = "forbidden",
    justification = "SDD: --no-verify salta los ganchos de calidad. Corrige la causa del fallo, no lo esquives.",
)
